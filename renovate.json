{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "1 week",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchJsonata": [
        "depType = 'dependency-groups' and managerData.depGroup = 'dev'"
      ],
      "automerge": true
    }
  ]
}
